<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630" role="img" aria-label="Wacom for Windows OG image">
  <defs>
    <linearGradient id="glow" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#00b0ff" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#00b0ff" stop-opacity="0"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="12" flood-color="#000" flood-opacity="0.55"/>
    </filter>
    <style><![CDATA[
      .title { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; font-weight: 800; fill: #ffffff; }
      .subtitle { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; font-weight: 500; fill: #bdbdbd; }
      .badge { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; font-weight: 600; fill: #dfe3e6; }
      .buttonText { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; font-weight: 800; fill: #001018; letter-spacing: .3px; }
      .mini { font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; font-weight: 500; fill: #9aa3ab; }
      .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    ]]></style>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="#0a0a0a"/>
  <rect x="700" y="-40" width="620" height="620" rx="40" fill="url(#glow)"/>
  <circle cx="1010" cy="140" r="110" fill="#00b0ff" fill-opacity="0.06"/>
  <circle cx="1060" cy="420" r="140" fill="#00b0ff" fill-opacity="0.05"/>

  <!-- Left content card -->
  <g filter="url(#shadow)">
    <rect x="80" y="80" width="760" height="470" rx="24" fill="#111213" stroke="#1f2022"/>
  </g>

  <!-- Brand mark -->
  <g transform="translate(120,130)">
    <rect x="0" y="0" width="72" height="72" rx="14" fill="#ffffff"/>
    <path d="M10 20 L22 56 L36 32 L50 56 L62 20" stroke="#000000" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="60" cy="14" r="8" fill="#00b0ff"/>
  </g>

  <!-- Badge -->
  <g transform="translate(220,140)">
    <rect x="0" y="0" width="370" height="40" rx="20" fill="#121316" stroke="#1f2022"/>
    <g transform="translate(16,27)">
      <circle cx="0" cy="-6" r="6" fill="#00b0ff"/>
    </g>
    <text x="36" y="26" class="badge" font-size="18">Windows 10 / 11 • Driver v6.4.13-4</text>
  </g>

  <!-- Title -->
  <text x="220" y="230" class="title" font-size="56">Download Wacom Driver for Windows</text>

  <!-- Subtitle -->
  <text x="220" y="280" class="subtitle" font-size="26">Safe direct link from Wacom CDN • Install steps • Quick fixes</text>

  <!-- CTA Button -->
  <g transform="translate(220,320)">
    <rect x="0" y="0" width="430" height="72" rx="14" fill="#00b0ff"/>
    <text x="24" y="47" class="buttonText" font-size="28">Download Now (WacomTablet_6.4.13-4.exe)</text>
  </g>

  <!-- Secondary links (visual only) -->
  <g transform="translate(220,410)">
    <rect x="0" y="0" width="220" height="50" rx="12" fill="#15161a" stroke="#1f2022"/>
    <text x="18" y="32" class="subtitle" font-size="20">Install Guide</text>
    <rect x="240" y="0" width="250" height="50" rx="12" fill="#15161a" stroke="#1f2022"/>
    <text x="258" y="32" class="subtitle" font-size="20">Fix Pen Not Working</text>
  </g>

  <!-- Bottom note -->
  <text x="100" y="570" class="mini" font-size="18">Unofficial helper site — not affiliated with Wacom Co., Ltd. Direct download: <tspan class="mono">cdn.wacom.com</tspan></text>
</svg>
